# Global Runners Logistics — environment variables
# Local: copy to .env.local (never committed). Production: same keys in Vercel → Project → Settings → Environment Variables.
# Lines marked [SECRET] must never be shared or pasted in chat.

# ───────── Site ─────────
NEXT_PUBLIC_SITE_URL=https://globalrunnerslogistics.com
# Search indexing — "true" only on production
NEXT_PUBLIC_ALLOW_INDEXING=false
# Search Console / Bing Webmaster HTML-tag verification (content value only; leave empty if verified by DNS)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ───────── Supabase ─────────  (Dashboard → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://ercilamdgoyypghzrwic.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_HQjn15fWCWGVLky_6ePhMQ_JJb1zMg1
# [SECRET] "secret" key (sb_secret_…) — used only on the server by webhooks and the worker
SUPABASE_SECRET_KEY=

# ───────── Instantly (cold email) ─────────  (Settings → Integrations → API Keys, scope all:all)
# [SECRET]
INSTANTLY_API_KEY=
# [SECRET] any long random string; we send it as a header on the Instantly webhook
INSTANTLY_WEBHOOK_SECRET=

# ───────── Quo (texts + calls) ─────────  (Settings → API)
# [SECRET]
QUO_API_KEY=
# [SECRET] signing key shown when the API webhook is created
QUO_WEBHOOK_SECRET=
# Quo number that sends texts (E.164)
QUO_FROM_NUMBER=+17256661558

# ───────── DeepSeek (assistant) ─────────  (platform.deepseek.com → API keys)
# [SECRET]
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Hard stop for assistant spend per month, in USD
DEEPSEEK_MONTHLY_CAP_USD=50

# ───────── Resend (system email: alerts, digests) ─────────  (resend.com → API Keys)
# [SECRET]
RESEND_API_KEY=
NOTIFY_EMAIL_FROM="Global Runners Logistics <apply@globalrunnerslogistics.com>"

# ───────── Alerts to Ken / team ─────────
NOTIFY_EMAIL_TO=lsbco@grlbco.com

# Direct email to drivers with no Instantly thread (Resend, domain globalrunnerslogistics.com is verified).
DRIVER_EMAIL_FROM="Ken Aman <ken@globalrunnerslogistics.com>"
# Optional: replies into the CRM. Enable receiving on a subdomain in Resend (e.g. reply.globalrunnerslogistics.com),
# add its MX record, create a webhook for email.received → https://globalrunnerslogistics.com/api/hooks/resend
RESEND_INBOUND_ADDRESS=
RESEND_WEBHOOK_SECRET=

# Telegram group alerts for Ken (form submitted, driver needs a person).
# 1) Telegram: message @BotFather, /newbot, copy the token here.
# 2) Add the bot to Ken's group, send any message in the group.
# 3) Open http://localhost:3000/api/dev/telegram, copy the group "id" (starts with -100…) into TELEGRAM_CHAT_ID.
# 4) Test: http://localhost:3000/api/dev/telegram?test=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_SMS_TO=+13129753377

# ───────── Background worker ─────────
# [SECRET] any long random string; pg_cron sends it when calling /api/worker/tick
WORKER_SECRET=
# Master kill switch for all automatic sending
SENDING_ENABLED=false
